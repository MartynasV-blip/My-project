# ---------------------------------------------------------------
# Unity .gitignore
# Place this file in the REPO ROOT (next to Assets/, Packages/,
# ProjectSettings/) and name it exactly:  .gitignore
# ---------------------------------------------------------------

# Unity-generated folders — never commit these, they rebuild locally
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code generated files
.vs/
.vscode/
.idea/
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# Unity3D generated meta files for folders we ignore
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Archives — don't commit zips of the project
*.zip
*.rar
*.7z
